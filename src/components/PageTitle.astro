---
// Starlight's title plus a trust stamp: who owns the page and when a person
// last checked it against the real system. The stamp is a tab, like an
// inspection tag clipped to a binder page: mint when verified, amber when
// stale, grey when nobody has checked it yet.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry } = Astro.locals.starlightRoute;
const { owner, lastVerified, reviewEvery, template, description } = entry.data;
const showMeta = template !== 'splash';

const DAY = 24 * 60 * 60 * 1000;
const ageDays = lastVerified ? Math.floor((Date.now() - lastVerified.getTime()) / DAY) : null;
const state = ageDays === null ? 'unverified' : ageDays > reviewEvery ? 'stale' : 'fresh';
const date = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const ago = (n: number) => (n === 0 ? 'today' : n === 1 ? 'yesterday' : `${n} days ago`);

const label = {
	fresh: lastVerified && `Verified ${date(lastVerified)}`,
	stale: lastVerified && `Stale: last verified ${date(lastVerified)}`,
	unverified: 'Not verified yet',
}[state];
---

<Default />
{showMeta && description && <p class="page-lede">{description}</p>}
{
	showMeta && (
		<div class:list={['stamp', `stamp--${state}`]}>
			<span class="stamp__tab">{label}</span>
			<span class="stamp__facts">
				<span>
					Owner <strong>{owner ?? 'unassigned'}</strong>
				</span>
				{ageDays !== null && <span>Checked {ago(ageDays)}</span>}
				<span>Review every {reviewEvery} days</span>
			</span>
			{state === 'stale' && <span class="stamp__note">Check this page against the real system before you rely on it.</span>}
			{state === 'unverified' && <span class="stamp__note">Treat it as a draft until someone checks it against the real system.</span>}
		</div>
	)
}
