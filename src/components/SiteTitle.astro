---
// Wordmark: the starburst mark (same as the favicon) beside the name.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
	<svg class="site-title__mark" viewBox="0 0 128 128" aria-hidden="true">
		<path fill="currentColor" fill-rule="evenodd" d="M81 36 64 0 47 36l-1 2-9-10a6 6 0 0 0-9 9l10 10h-2L0 64l36 17h2L28 91a6 6 0 1 0 9 9l9-10 1 2 17 36 17-36v-2l9 10a6 6 0 1 0 9-9l-9-9 2-1 36-17-36-17-2-1 9-9a6 6 0 1 0-9-9l-9 10v-2Zm-17 2-2 5c-4 8-11 15-19 19l-5 2 5 2c8 4 15 11 19 19l2 5 2-5c4-8 11-15 19-19l5-2-5-2c-8-4-15-11-19-19l-2-5Z" clip-rule="evenodd"></path>
		<path fill="currentColor" d="M118 19a6 6 0 0 0-9-9l-3 3a6 6 0 1 0 9 9l3-3Zm-96 4c-2 2-6 2-9 0l-3-3a6 6 0 1 1 9-9l3 3c3 2 3 6 0 9Zm0 82c-2-2-6-2-9 0l-3 3a6 6 0 1 0 9 9l3-3c3-2 3-6 0-9Zm96 4a6 6 0 0 1-9 9l-3-3a6 6 0 1 1 9-9l3 3Z"></path>
	</svg>
	<span translate="no">{siteTitle}</span>
</a>

<style>
	.site-title {
		align-items: center;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	.site-title__mark {
		width: 1.6rem;
		height: 1.6rem;
		flex: none;
		transition: transform 0.5s var(--ease-out);
	}
	.site-title:hover .site-title__mark {
		transform: rotate(45deg);
	}
</style>
