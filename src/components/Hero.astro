---
// Home page hero (Starlight renders Hero only for pages with `hero:` in
// frontmatter, i.e. the home page). Left: a mint divider page whose index
// tabs are the nine sections. Right: the owner's own systems, each as a tab
// filed in the binder: what it is, and whether it's public or private.
// Only public hostnames appear here (see CLAUDE.md, Rule 1).
import { sections } from '../sections.mjs';
import { loadHandbook } from '../lib/handbook';

const systems = [
	{ name: 'Handbook', what: 'these docs', where: 'book.karthiksurkanti.in', href: '/services/handbook/' },
	{ name: 'Slate', what: 'notes app, web and MCP', where: 'lib.karthiksurkanti.in', href: '/architecture/system-overview/' },
	{ name: 'Sprawl', what: 'canvas app and its MCP', where: 'canvas-mcp.karthiksurkanti.in', href: '/architecture/system-overview/' },
	{ name: 'Orbit Identity', what: 'sign-in for the MCP servers', where: 'auth.karthiksurkanti.in', href: '/services/orbit-identity/' },
	{ name: 'Orbit', what: 'cluster console and app catalog', where: 'private', href: '/services/orbit/' },
	{ name: 'AnythingTCG', what: 'card game server', where: 'private notes', href: '/architecture/system-overview/' },
];

const { totals } = await loadHandbook();
---

<section class="hb-hero not-content" aria-labelledby="hb-hero-title">
	<div class="hb-hero__card">
		<nav class="hb-index" aria-label="Sections">
			{
				sections.map((s) => (
					<a class="hb-index__tab" href={s.start}>
						{s.tab}
					</a>
				))
			}
		</nav>

		<div class="hb-hero__body">
			<h1 id="hb-hero-title" class="hb-hero__title" data-rise>run everything by&nbsp;hand.</h1>
			<p class="hb-hero__lede" data-rise>
				My handbook for everything I run on my home server: what each system is, how to operate it, and how to fix it when it breaks.
				Written so I can do all of it myself, with no AI to lean on.
			</p>
			<div class="hb-hero__actions" data-rise>
				<a class="hb-btn" href="/start-here/overview/">Start reading</a>
				<a class="hb-btn hb-btn--quiet" href="/start-here/if-something-is-broken/">Something is broken</a>
			</div>
		</div>

		<p class="hb-hero__foot" data-rise>
			<button type="button" class="hb-textlink" data-open-search>Search every page <kbd>Ctrl K</kbd></button>
			<a class="hb-textlink" href="/operations/automation-inventory/">What AI used to do</a>
			<a class="hb-textlink" href="/start-here/writing-docs/">Fix a page</a>
		</p>
	</div>

	<div class="hb-run">
		<p class="hb-run__tab">What I run</p>
		<div class="hb-run__page">
			<ul class="hb-run__list">
				{
					systems.map((s, i) => (
						<li style={`--i:${i}`}>
							<a class="hb-run__item" href={s.href}>
								<span class="hb-run__name">{s.name}</span>
								<span class="hb-run__what">{s.what}</span>
								<span class:list={['hb-run__where', { 'is-private': !s.where.includes('.') }]}>{s.where}</span>
							</a>
						</li>
					))
				}
			</ul>
			<p class="hb-run__foot">
				One home server, {totals.pages} pages, {totals.verified} checked by hand so far.
			</p>
		</div>
	</div>
</section>

<script>
	// "Search every page" opens Starlight's own search dialog.
	document.querySelectorAll('[data-open-search]').forEach((b) =>
		b.addEventListener('click', (e) => {
			// Stop this click reaching Starlight's 'click outside closes search' listener.
			e.stopPropagation();
			document.querySelector<HTMLButtonElement>('button[data-open-modal]')?.click();
		}),
	);
</script>
